{
  "name": "whispree-electron",
  "productName": "Whispree Electron",
  "version": "0.1.0",
  "description": "Codex-style Electron/Vite migration shell for Whispree.",
  "main": ".vite/build/main.js",
  "private": true,
  "author": {
    "name": "Arsture"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run check:workflows && npm run check:boundaries && npm run typecheck && npm run lint && npm run test:parity-script && npm run test:signing-preflight && npm run test:readiness-probe && npm run test:visual-diff && npm test",
    "check:workflows": "node scripts/check-workflows.mjs",
    "probe:real": "node scripts/real-readiness-probe.mjs",
    "parity:capture": "node scripts/capture-visual-parity.mjs",
    "signing:preflight": "node scripts/signing-preflight.mjs --report-only",
    "signing:preflight:release": "node scripts/signing-preflight.mjs --strict-release",
    "test:parity-script": "node scripts/capture-visual-parity.test.mjs",
    "test:signing-preflight": "node scripts/signing-preflight.test.mjs",
    "smoke:packaged-app": "node scripts/smoke-packaged-app.mjs",
    "tabs:capture": "node scripts/capture-packaged-tabs.mjs",
    "build:macos-hotkey-helper": "node scripts/build-macos-hotkey-helper.mjs",
    "prepackage": "npm run build:macos-hotkey-helper",
    "premake": "npm run build:macos-hotkey-helper",
    "test:readiness-probe": "node scripts/real-readiness-probe.test.mjs",
    "visual:diff-tabs": "node scripts/compare-visual-tabs.mjs",
    "test:visual-diff": "node scripts/compare-visual-tabs.test.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "42.4.0",
    "eslint": "10.5.0",
    "globals": "17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "tar": "7.5.16",
    "tmp": "0.2.7"
  }
}
